{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "oxc", "unicorn", "import"],
  "categories": { "correctness": "error" },
  "env": { "browser": true, "serviceworker": true, "es2024": true },
  "rules": {
    "eqeqeq": ["error", "smart"],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": ["warn", { "additionalHooks": "^useGameDataMemo$" }],
    "react/self-closing-comp": ["error", { "component": true, "html": false }],
    "typescript/explicit-member-accessibility": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "warn",
    "typescript/require-await": "warn",
    "typescript/no-unused-vars": "warn",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-unsafe-argument": "off",
    "typescript/no-unsafe-assignment": "off",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-member-access": "off",
    "typescript/no-unsafe-return": "off",
    // 只对 React Compiler 有意义，构建里没有启用 React Compiler
    "react/incompatible-library": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**", "vite.config.ts"],
      "env": { "node": true, "browser": false, "serviceworker": false }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "src/pkg/cpp-data-schemas/**",
    // 主 checkout 下的 agent worktree
    ".claude/**"
  ]
}
